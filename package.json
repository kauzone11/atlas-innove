{
  "name": "atlas-innove",
  "version": "0.1.0",
  "private": true,
  "author": "kauzone11",
  "description": "Multi-tenant SaaS platform for longitudinal monitoring of ventures supported by innovation and funding programs.",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "test:demo": "tsx --test src/lib/demo/demo.test.ts",
    "test:security": "tsx --test src/lib/auth/authorization.test.ts src/lib/auth/tenant.test.ts src/lib/domain-invariants.test.ts",
    "test:domain": "tsx --test src/lib/domain-integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.511.0",
    "next": "15.5.26",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.29.0",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "postcss": "8.5.28"
  }
}
