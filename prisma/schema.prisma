  requesterUserId String
  recipientUserId String
  userAId         String
  userBId         String
  message         String?
  status          NetworkRequestStatus @default(PENDING)
  createdAt       DateTime             @default(now())
  respondedAt     DateTime?
  cancelledAt     DateTime?
  requester       User                 @relation("ConnectionRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  recipient       User                 @relation("ConnectionRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  connection      NetworkConnection?

  @@index([recipientUserId, status, createdAt])
  @@index([requesterUserId, createdAt])
}

model NetworkConnection {
  id              String            @id @default(cuid())
  userAId         String
  userBId         String
  sourceRequestId String            @unique
  connectedAt     DateTime          @default(now())
  endedAt         DateTime?
  endedByUserId   String?
  userA           User              @relation("ConnectionUserA", fields: [userAId], references: [id], onDelete: Restrict)
  userB           User              @relation("ConnectionUserB", fields: [userBId], references: [id], onDelete: Restrict)
  sourceRequest   ConnectionRequest @relation(fields: [sourceRequestId], references: [id], onDelete: Restrict)
  endedBy         User?             @relation("ConnectionEndedBy", fields: [endedByUserId], references: [id], onDelete: Restrict)

  @@index([userAId, endedAt, connectedAt])
  @@index([userBId, endedAt, connectedAt])
}

model ProjectCollaborationRequest {
  id                String               @id @default(cuid())
  projectId         String
  requesterUserId   String
  message           String?
  status            NetworkRequestStatus @default(PENDING)
  respondedByUserId String?
  respondedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime             @default(now())
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester         User                 @relation("ProjectRequestRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  respondedBy       User?                @relation("ProjectRequestReviewer", fields: [respondedByUserId], references: [id], onDelete: Restrict)

  @@index([projectId, status, createdAt])
  @@index([requesterUserId, createdAt])
}

model ProjectInvite {
  id              String      @id @default(cuid())
  projectId       String
  invitedUserId   String
  invitedByUserId String
  role            ProjectRole @default(MEMBER)
  expiresAt       DateTime
  acceptedAt      DateTime?
  declinedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime    @default(now())
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedUser     User        @relation("ProjectInviteTarget", fields: [invitedUserId], references: [id], onDelete: Restrict)
  invitedBy       User        @relation("ProjectInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([invitedUserId, expiresAt])
  @@index([projectId, expiresAt])
  @@index([invitedByUserId, createdAt])
}

model UserBlock {
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())
  blocker       User     @relation("BlockInitiator", fields: [blockerUserId], references: [id], onDelete: Restrict)
  blocked       User     @relation("BlockTarget", fields: [blockedUserId], references: [id], onDelete: Restrict)

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

model Notification {
  id              String           @id @default(cuid())
  recipientUserId String
  actorUserId     String?
  kind            NotificationKind
  entityType      String?
  entityId        String?
  title           String
  body            String?
  href            String
  dedupeKey       String
  readAt          DateTime?
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  recipient       User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  actor           User?            @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([recipientUserId, dedupeKey])
  @@index([recipientUserId, archivedAt, createdAt, id])
  @@index([recipientUserId, readAt, archivedAt])
}

model Conversation {
  id            String                    @id @default(cuid())
  userAId       String
  userBId       String
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lastMessageAt DateTime?
  userA         User                      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Restrict)
  userB         User                      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Restrict)
  participants  ConversationParticipant[]
  messages      DirectMessage[]
  safetyReports SafetyReport[]

  @@unique([userAId, userBId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  archivedAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId, archivedAt, conversationId])
}

model DirectMessage {
  id             String         @id @default(cuid())
  conversationId String
  senderUserId   String
  body           String
  createdAt      DateTime       @default(now())
  deletedAt      DateTime?
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User           @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  safetyReports  SafetyReport[]

  @@index([conversationId, createdAt, id])
  @@index([senderUserId, createdAt])
}

model ProjectDiscussion {
  id              String                          @id @default(cuid())
  projectId       String
  title           String
  status          ProjectDiscussionStatus         @default(OPEN)
  createdByUserId String
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  project         Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User                            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  messages        ProjectDiscussionMessage[]
  subscriptions   ProjectDiscussionSubscription[]

  @@index([projectId, updatedAt, id])
  @@index([createdByUserId, createdAt])
}

model ProjectDiscussionMessage {
  id           String            @id @default(cuid())
  discussionId String
  authorUserId String
  body         String
  createdAt    DateTime          @default(now())
  deletedAt    DateTime?
  discussion   ProjectDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author       User              @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([discussionId, createdAt, id])
  @@index([authorUserId, createdAt])
}

model ProjectDiscussionSubscription {
  discussionId String
  userId       String
  createdAt    DateTime          @default(now())
  discussion   ProjectDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([discussionId, userId])
}

model SafetyReport {
  id               String             @id @default(cuid())
  reporterUserId   String
  reportedUserId   String
  conversationId   String?
  messageId        String?
  postId           String?
  commentId        String?
  reason           SafetyReportReason
  details          String?
  status           SafetyReportStatus @default(OPEN)
  createdAt        DateTime           @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  reporter         User               @relation("SafetyReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  reported         User               @relation("SafetyReported", fields: [reportedUserId], references: [id], onDelete: Restrict)
  conversation     Conversation?      @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message          DirectMessage?     @relation(fields: [messageId], references: [id], onDelete: Restrict)
  reviewedBy       User?              @relation("SafetyReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  post             SocialPost?        @relation(fields: [postId], references: [id], onDelete: Restrict)
  comment          PostComment?       @relation(fields: [commentId], references: [id], onDelete: Restrict)

  @@index([status, createdAt, id])
  @@index([reporterUserId, createdAt])
}

enum FollowPolicy {
  EVERYONE
  CONNECTIONS_ONLY
}

enum PrimaryProfileAction {
  CONNECT
  FOLLOW
}

enum PostVisibility {
  PUBLIC
  PLATFORM
  CONNECTIONS
}

enum PostCommentPolicy {
  EVERYONE
  CONNECTIONS_ONLY
  OFF
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  LOVE
  INSIGHTFUL
  FUNNY
}

model UserFollow {
  id             String    @id @default(cuid())
  followerUserId String
  followedUserId String
  createdAt      DateTime  @default(now())
  endedAt        DateTime?
  follower       User      @relation("FollowFollower", fields: [followerUserId], references: [id], onDelete: Cascade)
  followed       User      @relation("FollowFollowed", fields: [followedUserId], references: [id], onDelete: Cascade)

  @@index([followerUserId, endedAt, createdAt, id])
  @@index([followedUserId, endedAt, createdAt, id])
}

model SocialPost {
  id             String            @id @default(cuid())
  authorUserId   String
  body           String?
  visibility     PostVisibility    @default(PLATFORM)
  commentPolicy  PostCommentPolicy @default(EVERYONE)
  allowReposts   Boolean           @default(true)
  externalUrl    String?
  repostOfPostId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  editedAt       DateTime?
  deletedAt      DateTime?
  author         User              @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  repostOf       SocialPost?       @relation("PostRepost", fields: [repostOfPostId], references: [id], onDelete: Restrict)
  reposts        SocialPost[]      @relation("PostRepost")
  reactions      PostReaction[]
  comments       PostComment[]
  saves          SavedPost[]
  featured       FeaturedPost[]
  safetyReports  SafetyReport[]

  @@index([authorUserId, deletedAt, createdAt, id])
  @@index([visibility, deletedAt, createdAt, id])
  @@index([repostOfPostId, deletedAt])
}

model PostReaction {
  postId    String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  post      SocialPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model PostComment {
  id                   String            @id @default(cuid())
  postId               String
  authorUserId         String
  parentCommentId      String?
  body                 String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  editedAt             DateTime?
  deletedAt            DateTime?
  hiddenByPostAuthorAt DateTime?
  post                 SocialPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  author               User              @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  parentComment        PostComment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Restrict)
  replies              PostComment[]     @relation("CommentReplies")
  reactions            CommentReaction[]
  safetyReports        SafetyReport[]

  @@unique([postId, id])
  @@index([postId, parentCommentId, createdAt, id])
  @@index([authorUserId, createdAt, id])
}

model CommentReaction {
  commentId String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  comment   PostComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId, createdAt])
}

model SavedPost {
  userId    String
  postId    String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt, postId])
}

model FeaturedPost {
  userId    String
  postId    String
  position  Int
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@unique([userId, position])
}

model SocialRateLimitEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @db.VarChar(32)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

enum ImportType {
  FUNDING_PROGRAMS
  FUNDING_CALLS
  COHORTS
  VENTURES
  VENTURE_ENROLLMENTS
  FOLLOW_UP_WAVES
  OBSERVATIONS
  MILESTONES
}

enum ImportStatus {
  UPLOADED
  VALIDATING
  READY
  APPLYING
  APPLIED
  FAILED
  ROLLED_BACK
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  APPLIED
  SKIPPED
  ROLLED_BACK
}

enum ImportOperation {
  CREATE
  UPDATE
}

model ImportBatch {
  id                 String              @id @default(cuid())
  organizationId     String
  type               ImportType
  status             ImportStatus        @default(UPLOADED)
  revision           Int                 @default(1)
  schemaVersion      Int                 @default(1)
  namespace          String              @db.VarChar(80)
  sourceName         String?             @db.VarChar(200)
  sourceDigest       String              @db.VarChar(64)
  delimiter          String              @db.VarChar(1)
  headers            Json
  mapping            Json                @default("{}")
  options            Json                @default("{}")
  mappingConfirmedAt DateTime?
  totalRows          Int
  validRows          Int                 @default(0)
  invalidRows        Int                 @default(0)
  warningRows        Int                 @default(0)
  appliedRows        Int                 @default(0)
  createdByUserId    String
  appliedByUserId    String?
  rolledBackByUserId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  validatedAt        DateTime?
  appliedAt          DateTime?
  failedAt           DateTime?
  rolledBackAt       DateTime?
  failureCode        String?             @db.VarChar(80)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          User                @relation("ImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  appliedBy          User?               @relation("ImportAppliedBy", fields: [appliedByUserId], references: [id], onDelete: Restrict)
  rolledBackBy       User?               @relation("ImportRolledBackBy", fields: [rolledBackByUserId], references: [id], onDelete: Restrict)
  rows               ImportRow[]
  changes            ImportChange[]
  externalReferences ExternalReference[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, namespace, type, sourceDigest])
}

model ImportRow {
  id                 String          @id @default(cuid())
  organizationId     String
  batchId            String
  rowNumber          Int
  rawData            Json
  normalizedData     Json?
  status             ImportRowStatus @default(PENDING)
  errors             Json            @default("[]")
  warnings           Json            @default("[]")
  resolvedReferences Json?
  createdAt          DateTime        @default(now())
  batch              ImportBatch     @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Cascade)
  changes            ImportChange[]

  @@unique([organizationId, batchId, id])
  @@unique([batchId, rowNumber])
  @@index([organizationId, batchId, status, rowNumber])
}

model ImportChange {
  id             String          @id @default(cuid())
  organizationId String
  batchId        String
  rowId          String?
  entityType     ImportType
  entityId       String
  operation      ImportOperation
  beforeData     Json?
  afterDigest    String          @db.VarChar(64)
  createdAt      DateTime        @default(now())
  rolledBackAt   DateTime?
  batch          ImportBatch     @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Cascade)
  row            ImportRow?      @relation(fields: [organizationId, batchId, rowId], references: [organizationId, batchId, id], onDelete: NoAction)

  @@unique([organizationId, batchId, entityType, entityId])
  @@index([organizationId, entityType, entityId])
}

model ExternalReference {
  id                     String       @id @default(cuid())
  organizationId         String
  namespace              String       @db.VarChar(80)
  entityType             ImportType
  externalId             String       @db.VarChar(160)
  entityId               String
  createdByImportBatchId String?
  createdAt              DateTime     @default(now())
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByImportBatch   ImportBatch? @relation(fields: [organizationId, createdByImportBatchId], references: [organizationId, id], onDelete: NoAction)

  @@unique([organizationId, namespace, entityType, externalId], map: "ExternalReference_tenant_source_key")
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdByImportBatchId])
}
