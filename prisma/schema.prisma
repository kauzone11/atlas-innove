generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum FundingProgramStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum FundingCallStatus {
  DRAFT
  OPEN
  IN_REVIEW
  CLOSED
  RESULT_PUBLISHED
  ARCHIVED
}

enum FundingCallDocumentType {
  NOTICE
  ANNEX
  AMENDMENT
  RESULT
  OTHER
}

enum IndicatorValueType {
  INTEGER
  CURRENCY
  ENUM
}

enum MilestoneType {
  MVP_LAUNCHED
  FIRST_CUSTOMER
  COMPANY_FORMALIZED
  RECURRING_CONTRACT
  ADDITIONAL_INVESTMENT
  TEAM_EXPANSION
  PIVOT
  CLOSED
}

enum OpportunityStatus {
  OPEN
  UPCOMING
  IN_REVIEW
  CLOSED
  RESULT_PUBLISHED
  ARCHIVED
}

enum CohortStatus {
  PLANNED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum VentureKind {
  COMPANY
  PROJECT
  INITIATIVE
  OTHER
}

enum VentureEnrollmentStatus {
  ACTIVE
  WITHDRAWN
}

enum FollowUpWaveKind {
  BASELINE
  FOLLOW_UP
}

enum FollowUpWaveStatus {
  PLANNED
  OPEN
  CLOSED
  ARCHIVED
}

enum VentureObservationStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  MISSED
}

enum TeamRole {
  OWNER
  LEAD
  MEMBER
}

enum ProjectRole {
  OWNER
  LEAD
  MEMBER
}

enum ProjectStatus {
  IDEA
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  DECIDED
  WITHDRAWN
}

enum ApplicationDecision {
  PENDING
  SELECTED
  WAITLIST
  NOT_SELECTED
  DISQUALIFIED
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
}

enum VisibilityScope {
  PUBLIC
  PLATFORM
  TEAM
  PRIVATE
}

enum ProfileTopicType {
  SKILL
  INTEREST
}

enum ProfileLinkType {
  WEBSITE
  LINKEDIN
  GITHUB
  ORCID
  PORTFOLIO
  OTHER
}

enum OpportunitySupportType {
  SUBVENTION
  SCHOLARSHIP
  CREDIT
  RESIDENCY
  ACCELERATION
  PRIZE
  SERVICES
  OTHER
}

enum OpportunityTerritoryScope {
  MUNICIPAL
  STATE
  REGIONAL
  NATIONAL
  INTERNATIONAL
  UNSPECIFIED
}

model User {
  id                         String                     @id @default(cuid())
  email                      String                     @unique
  passwordHash               String
  platformRole               PlatformRole               @default(USER)
  sessionVersion             Int                        @default(0)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  profile                    UserProfile?
  memberships                OrganizationMembership[]
  invitationsSent            OrganizationInvite[]       @relation("InvitedBy")
  sessions                   Session[]
  passwordResetTokens        PasswordResetToken[]
  fundingProgramsCreated     FundingProgram[]           @relation("FundingProgramCreatedBy")
  teamsCreated               Team[]                     @relation("TeamCreatedBy")
  teamMemberships            TeamMembership[]
  teamInvitesSent            TeamInvite[]               @relation("TeamInvitedBy")
  teamInvitesAccepted        TeamInvite[]               @relation("TeamInviteAcceptedBy")
  projectsCreated            Project[]                  @relation("ProjectCreatedBy")
  projectMemberships         ProjectMembership[]
  applicationsSubmitted      Application[]              @relation("ApplicationSubmittedBy")
  applicationDecisions       Application[]              @relation("ApplicationDecidedBy")
  applicationEvaluations     ApplicationEvaluation[]
  innovationProfile          InnovationProfile?
  savedFundingCalls          SavedFundingCall[]
  savedExternalOpportunities SavedExternalOpportunity[]
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  jobTitle  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InnovationProfile {
  id                              String              @id @default(cuid())
  userId                          String              @unique
  handle                          String?             @unique @db.VarChar(64)
  headline                        String?
  bio                             String?
  city                            String?
  state                           String?
  country                         String?
  profileVisibility               VisibilityScope     @default(PRIVATE)
  skillsVisibility                VisibilityScope     @default(PRIVATE)
  experienceVisibility            VisibilityScope     @default(PRIVATE)
  educationVisibility             VisibilityScope     @default(PRIVATE)
  linksVisibility                 VisibilityScope     @default(PRIVATE)
  verifiedParticipationVisibility VisibilityScope     @default(PRIVATE)
  projectsVisibility              VisibilityScope     @default(PRIVATE)
  publishedAt                     DateTime?
  createdAt                       DateTime            @default(now())
  updatedAt                       DateTime            @updatedAt
  user                            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics                          ProfileTopic[]
  education                       ProfileEducation[]
  experience                      ProfileExperience[]
  links                           ProfileLink[]
}

model ProfileTopic {
  id            String            @id @default(cuid())
  profileId     String
  type          ProfileTopicType
  label         String
  normalizedKey String
  position      Int               @default(0)
  profile       InnovationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type, normalizedKey])
  @@index([profileId, type, position])
}

model ProfileEducation {
  id          String            @id @default(cuid())
  profileId   String
  institution String
  course      String
  degree      String?
  startsAt    DateTime?         @db.Date
  endsAt      DateTime?         @db.Date
  description String?
  visibility  VisibilityScope   @default(PRIVATE)
  position    Int               @default(0)
  profile     InnovationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

model ProfileExperience {
  id               String            @id @default(cuid())
  profileId        String
  organizationName String
  title            String
  startsAt         DateTime          @db.Date
  endsAt           DateTime?         @db.Date
  current          Boolean           @default(false)
  description      String?
  visibility       VisibilityScope   @default(PRIVATE)
  position         Int               @default(0)
  profile          InnovationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

model ProfileLink {
  id         String            @id @default(cuid())
  profileId  String
  label      String
  url        String
  type       ProfileLinkType   @default(OTHER)
  visibility VisibilityScope   @default(PRIVATE)
  position   Int               @default(0)
  profile    InnovationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

model Organization {
  id                   String                    @id @default(cuid())
  name                 String
  slug                 String                    @unique
  status               OrganizationStatus        @default(ACTIVE)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  memberships          OrganizationMembership[]
  invites              OrganizationInvite[]
  activeSessions       Session[]                 @relation("SessionActiveOrganization")
  fundingPrograms      FundingProgram[]
  fundingCalls         FundingCall[]
  fundingCallDocuments FundingCallDocument[]
  cohorts              Cohort[]
  ventures             Venture[]
  enrollments          VentureEnrollment[]
  followUpWaves        FollowUpWave[]
  observations         VentureObservation[]
  trackingProtocols    TrackingProtocol[]
  protocolVersions     TrackingProtocolVersion[]
  indicatorDefinitions IndicatorDefinition[]
  observationValues    ObservationValue[]
  milestones           Milestone[]
  opportunities        Opportunity[]
  applications         Application[]
  evaluationCriteria   EvaluationCriterion[]
  evaluations          ApplicationEvaluation[]
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model OrganizationInvite {
  id              String           @id @default(cuid())
  organizationId  String
  invitedByUserId String
  email           String
  role            OrganizationRole
  status          InvitationStatus @default(PENDING)
  tokenHash       String           @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([email, status])
}

model Session {
  id                   String        @id @default(cuid())
  userId               String
  tokenHash            String        @unique
  sessionVersion       Int
  activeOrganizationId String?
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime      @default(now())
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation("SessionActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model FundingProgram {
  id              String               @id @default(cuid())
  organizationId  String
  name            String
  slug            String
  description     String?
  code            String?
  status          FundingProgramStatus @default(DRAFT)
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("FundingProgramCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cohorts         Cohort[]
  fundingCalls    FundingCall[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model FundingCall {
  id                   String                    @id @default(cuid())
  organizationId       String
  fundingProgramId     String
  title                String
  shortTitle           String?
  callNumber           String
  objective            String?
  status               FundingCallStatus         @default(DRAFT)
  publishedAt          DateTime?
  applicationStartsAt  DateTime?
  applicationEndsAt    DateTime?
  totalBudget          Decimal?                  @db.Decimal(14, 2)
  maximumSupport       Decimal?                  @db.Decimal(14, 2)
  targetProjects       Int?
  executionMonths      Int?
  sourceUrl            String?
  sourceCheckedAt      DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingProgram       FundingProgram            @relation(fields: [organizationId, fundingProgramId], references: [organizationId, id], onDelete: Cascade)
  cohorts              Cohort[]
  documents            FundingCallDocument[]
  applicationsEnabled  Boolean                   @default(false)
  evaluationStartedAt  DateTime?
  resultsPublishedAt   DateTime?
  applications         Application[]
  evaluationCriteria   EvaluationCriterion[]
  evaluations          ApplicationEvaluation[]
  publicListingEnabled Boolean                   @default(false)
  supportType          OpportunitySupportType    @default(OTHER)
  territoryScope       OpportunityTerritoryScope @default(UNSPECIFIED)
  territoryLabel       String?
  eligibleStates       String[]                  @default([])
  audienceTags         String[]                  @default([])
  thematicAreas        String[]                  @default([])
  savedBy              SavedFundingCall[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, fundingProgramId])
  @@unique([organizationId, callNumber])
  @@index([organizationId, status])
  @@index([publicListingEnabled, status, applicationEndsAt])
}

model FundingCallDocument {
  id                   String                  @id @default(cuid())
  organizationId       String
  fundingCallId        String
  type                 FundingCallDocumentType
  title                String
  externalUrl          String
  publishedAt          DateTime?
  publicListingEnabled Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingCall          FundingCall             @relation(fields: [organizationId, fundingCallId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, fundingCallId, title])
  @@index([organizationId, fundingCallId])
}

model Cohort {
  id                        String                   @id @default(cuid())
  organizationId            String
  fundingProgramId          String
  fundingCallId             String?
  trackingProtocolVersionId String?
  name                      String
  code                      String?
  referenceYear             Int?
  startsAt                  DateTime?
  endsAt                    DateTime?
  status                    CohortStatus             @default(PLANNED)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  organization              Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingProgram            FundingProgram           @relation(fields: [organizationId, fundingProgramId], references: [organizationId, id], onDelete: Cascade)
  fundingCall               FundingCall?             @relation(fields: [organizationId, fundingCallId, fundingProgramId], references: [organizationId, id, fundingProgramId], onDelete: Restrict)
  trackingProtocolVersion   TrackingProtocolVersion? @relation(fields: [organizationId, trackingProtocolVersionId], references: [organizationId, id], onDelete: Restrict)
  enrollments               VentureEnrollment[]
  followUpWaves             FollowUpWave[]
  observations              VentureObservation[]

  @@unique([organizationId, id])
  @@unique([organizationId, fundingProgramId, code])
  @@index([organizationId, fundingCallId])
  @@index([organizationId, trackingProtocolVersionId])
  @@index([organizationId, fundingProgramId, status])
}

model Venture {
  id                String              @id @default(cuid())
  organizationId    String
  name              String
  slug              String?
  legalName         String?
  kind              VentureKind
  externalReference String?
  archivedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sourceProjectId   String?
  sourceProject     Project?            @relation(fields: [sourceProjectId], references: [id], onDelete: Restrict)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments       VentureEnrollment[]
  milestones        Milestone[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@unique([organizationId, sourceProjectId])
  @@index([organizationId, kind, archivedAt])
}

model VentureEnrollment {
  id                String                  @id @default(cuid())
  organizationId    String
  cohortId          String
  ventureId         String
  externalReference String?
  enrolledAt        DateTime                @default(now())
  withdrawnAt       DateTime?
  status            VentureEnrollmentStatus @default(ACTIVE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  applicationId     String?
  application       Application?            @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Restrict)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cohort            Cohort                  @relation(fields: [organizationId, cohortId], references: [organizationId, id], onDelete: Cascade)
  venture           Venture                 @relation(fields: [organizationId, ventureId], references: [organizationId, id], onDelete: Cascade)
  observations      VentureObservation[]

  @@unique([organizationId, cohortId, ventureId])
  @@unique([organizationId, applicationId])
  @@unique([organizationId, cohortId, id])
  @@index([organizationId, cohortId, status])
  @@index([organizationId, cohortId, withdrawnAt])
  @@index([organizationId, ventureId, status])
}

model FollowUpWave {
  id             String               @id @default(cuid())
  organizationId String
  cohortId       String
  name           String
  kind           FollowUpWaveKind     @default(FOLLOW_UP)
  sequence       Int
  offsetMonths   Int?
  scheduledFor   DateTime?
  opensAt        DateTime?
  closesAt       DateTime?
  status         FollowUpWaveStatus   @default(PLANNED)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cohort         Cohort               @relation(fields: [organizationId, cohortId], references: [organizationId, id], onDelete: Cascade)
  observations   VentureObservation[]

  @@unique([organizationId, cohortId, id])
  @@unique([organizationId, cohortId, sequence])
  @@index([organizationId, cohortId, status])
}

model VentureObservation {
  id                  String                   @id @default(cuid())
  organizationId      String
  cohortId            String
  ventureEnrollmentId String
  followUpWaveId      String
  status              VentureObservationStatus @default(PENDING)
  revision            Int                      @default(0)
  startedAt           DateTime?
  submittedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cohort              Cohort                   @relation(fields: [organizationId, cohortId], references: [organizationId, id], onDelete: Cascade)
  ventureEnrollment   VentureEnrollment        @relation(fields: [organizationId, cohortId, ventureEnrollmentId], references: [organizationId, cohortId, id], onDelete: Cascade)
  followUpWave        FollowUpWave             @relation(fields: [organizationId, cohortId, followUpWaveId], references: [organizationId, cohortId, id], onDelete: Cascade)
  values              ObservationValue[]

  @@unique([organizationId, id])
  @@unique([organizationId, ventureEnrollmentId, followUpWaveId])
  @@index([organizationId, cohortId, status])
  @@index([organizationId, ventureEnrollmentId, status])
  @@index([organizationId, followUpWaveId, status])
}

model TrackingProtocol {
  id             String                    @id @default(cuid())
  organizationId String
  slug           String
  name           String
  description    String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       TrackingProtocolVersion[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
}

model TrackingProtocolVersion {
  id                 String                @id @default(cuid())
  organizationId     String
  trackingProtocolId String
  version            Int
  label              String?
  createdAt          DateTime              @default(now())
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackingProtocol   TrackingProtocol      @relation(fields: [organizationId, trackingProtocolId], references: [organizationId, id], onDelete: Cascade)
  cohorts            Cohort[]
  indicators         IndicatorDefinition[]

  @@unique([organizationId, id])
  @@unique([organizationId, trackingProtocolId, version])
}

model IndicatorDefinition {
  id                        String                  @id @default(cuid())
  organizationId            String
  trackingProtocolVersionId String
  key                       String
  label                     String
  valueType                 IndicatorValueType
  unit                      String?
  position                  Int                     @default(0)
  allowedValues             Json?
  organization              Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackingProtocolVersion   TrackingProtocolVersion @relation(fields: [organizationId, trackingProtocolVersionId], references: [organizationId, id], onDelete: Cascade)
  observationValues         ObservationValue[]

  @@unique([organizationId, id])
  @@unique([organizationId, trackingProtocolVersionId, key])
  @@index([organizationId, trackingProtocolVersionId, position])
}

model ObservationValue {
  id                    String              @id @default(cuid())
  organizationId        String
  observationId         String
  indicatorDefinitionId String
  integerValue          Int?
  decimalValue          Decimal?            @db.Decimal(14, 2)
  textValue             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  observation           VentureObservation  @relation(fields: [organizationId, observationId], references: [organizationId, id], onDelete: Cascade)
  indicatorDefinition   IndicatorDefinition @relation(fields: [organizationId, indicatorDefinitionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, observationId, indicatorDefinitionId])
  @@index([organizationId, indicatorDefinitionId])
}

model Milestone {
  id             String        @id @default(cuid())
  organizationId String
  ventureId      String
  type           MilestoneType
  title          String
  description    String?
  occurredAt     DateTime
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venture        Venture       @relation(fields: [organizationId, ventureId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, ventureId, occurredAt, title])
  @@index([organizationId, ventureId, occurredAt])
}

model Opportunity {
  id                   String                     @id @default(cuid())
  organizationId       String
  institution          String
  callNumber           String
  title                String
  objective            String
  territory            String
  audience             String?
  status               OpportunityStatus
  publishedAt          DateTime?
  applicationEndsAt    DateTime?
  sourceUrl            String
  sourceCheckedAt      DateTime
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publicListingEnabled Boolean                    @default(false)
  supportType          OpportunitySupportType     @default(OTHER)
  territoryScope       OpportunityTerritoryScope  @default(UNSPECIFIED)
  territoryLabel       String?
  eligibleStates       String[]                   @default([])
  audienceTags         String[]                   @default([])
  thematicAreas        String[]                   @default([])
  savedBy              SavedExternalOpportunity[]

  @@unique([organizationId, callNumber])
  @@index([organizationId, status])
  @@index([publicListingEnabled, status, applicationEndsAt])
}

model SavedFundingCall {
  id            String      @id @default(cuid())
  userId        String
  fundingCallId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundingCall   FundingCall @relation(fields: [fundingCallId], references: [id], onDelete: Cascade)

  @@unique([userId, fundingCallId])
  @@index([userId, createdAt])
}

model SavedExternalOpportunity {
  id            String      @id @default(cuid())
  userId        String
  opportunityId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId, createdAt])
}

model Team {
  id              String           @id @default(cuid())
  name            String
  description     String?
  createdByUserId String
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       User             @relation("TeamCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  memberships     TeamMembership[]
  invites         TeamInvite[]
  projects        Project[]
  applications    Application[]
}

model TeamMembership {
  id        String           @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole         @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  leftAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([teamId, userId])
  @@index([userId, status, leftAt])
}

model TeamInvite {
  id               String    @id @default(cuid())
  teamId           String
  invitedByUserId  String
  email            String?
  role             TeamRole  @default(MEMBER)
  tokenHash        String    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  team             Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy        User      @relation("TeamInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?     @relation("TeamInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([teamId, expiresAt])
}

model Project {
  id              String              @id @default(cuid())
  name            String
  summary         String
  description     String?
  status          ProjectStatus       @default(IDEA)
  createdByUserId String
  primaryTeamId   String?
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdBy       User                @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  primaryTeam     Team?               @relation(fields: [primaryTeamId], references: [id], onDelete: Restrict)
  memberships     ProjectMembership[]
  applications    Application[]
  ventures        Venture[]
  publicSlug      String?             @unique @db.VarChar(64)
  visibility      VisibilityScope     @default(PRIVATE)
  thematicAreas   String[]            @default([])
  websiteUrl      String?
  repositoryUrl   String?
  demoUrl         String?
  publishedAt     DateTime?

  @@index([primaryTeamId, archivedAt])
}

model ProjectMembership {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())
  leftAt    DateTime?
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([projectId, userId])
  @@index([userId, leftAt])
}

model Application {
  id                         String                  @id @default(cuid())
  organizationId             String
  fundingCallId              String
  projectId                  String
  teamId                     String?
  submittedByUserId          String
  status                     ApplicationStatus       @default(DRAFT)
  revision                   Int                     @default(0)
  projectNameSnapshot        String
  projectSummarySnapshot     String
  projectDescriptionSnapshot String?
  teamNameSnapshot           String?
  submittedAt                DateTime?
  withdrawnAt                DateTime?
  decision                   ApplicationDecision     @default(PENDING)
  decidedAt                  DateTime?
  decidedByUserId            String?
  decisionNote               String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  organization               Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingCall                FundingCall             @relation(fields: [organizationId, fundingCallId], references: [organizationId, id], onDelete: Cascade)
  project                    Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  team                       Team?                   @relation(fields: [teamId], references: [id], onDelete: Restrict)
  submittedBy                User                    @relation("ApplicationSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  decidedBy                  User?                   @relation("ApplicationDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  evaluations                ApplicationEvaluation[]
  enrollments                VentureEnrollment[]

  @@unique([organizationId, id])
  @@unique([organizationId, fundingCallId, id])
  @@unique([fundingCallId, projectId])
  @@index([organizationId, fundingCallId, status])
  @@index([projectId, submittedByUserId])
}

model EvaluationCriterion {
  id             String                       @id @default(cuid())
  organizationId String
  fundingCallId  String
  name           String
  description    String?
  weight         Decimal                      @db.Decimal(10, 4)
  maxScore       Decimal                      @db.Decimal(10, 4)
  position       Int                          @default(0)
  createdAt      DateTime                     @default(now())
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingCall    FundingCall                  @relation(fields: [organizationId, fundingCallId], references: [organizationId, id], onDelete: Cascade)
  scores         ApplicationEvaluationScore[]

  @@unique([organizationId, fundingCallId, id])
  @@index([organizationId, fundingCallId, position])
}

model ApplicationEvaluation {
  id              String                       @id @default(cuid())
  organizationId  String
  fundingCallId   String
  applicationId   String
  evaluatorUserId String
  status          EvaluationStatus             @default(DRAFT)
  revision        Int                          @default(0)
  submittedAt     DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingCall     FundingCall                  @relation(fields: [organizationId, fundingCallId], references: [organizationId, id], onDelete: Cascade)
  application     Application                  @relation(fields: [organizationId, fundingCallId, applicationId], references: [organizationId, fundingCallId, id], onDelete: Cascade)
  evaluator       User                         @relation(fields: [evaluatorUserId], references: [id], onDelete: Restrict)
  scores          ApplicationEvaluationScore[]

  @@unique([organizationId, fundingCallId, id])
  @@unique([organizationId, applicationId, evaluatorUserId])
  @@index([organizationId, fundingCallId, status])
}

model ApplicationEvaluationScore {
  id             String                @id @default(cuid())
  organizationId String
  fundingCallId  String
  evaluationId   String
  criterionId    String
  score          Decimal               @db.Decimal(10, 4)
  comment        String?
  evaluation     ApplicationEvaluation @relation(fields: [organizationId, fundingCallId, evaluationId], references: [organizationId, fundingCallId, id], onDelete: Cascade)
  criterion      EvaluationCriterion   @relation(fields: [organizationId, fundingCallId, criterionId], references: [organizationId, fundingCallId, id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
}
