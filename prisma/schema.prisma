model Award {
  id                String               @id @default(cuid())
  organizationId    String
  fundingCallId     String
  applicationId     String
  status            AwardStatus          @default(PREPARING)
  revision          Int                  @default(1)
  agreementNumber   String?
  approvedAmount    Decimal?             @db.Decimal(14, 2)
  counterpartAmount Decimal?             @db.Decimal(14, 2)
  signedAt          DateTime?            @db.Date
  startsAt          DateTime?            @db.Date
  endsAt            DateTime?            @db.Date
  activatedAt       DateTime?
  completedAt       DateTime?
  terminatedAt      DateTime?
  createdByUserId   String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingCall       FundingCall          @relation(fields: [organizationId, fundingCallId], references: [organizationId, id], onDelete: Restrict)
  application       Application          @relation(fields: [organizationId, fundingCallId, applicationId], references: [organizationId, fundingCallId, id], onDelete: Restrict)
  createdBy         User                 @relation("AwardCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  statusHistory     AwardStatusHistory[]
  obligations       AwardObligation[]
  disbursements     AwardDisbursement[]
  documents         AwardDocument[]
  enrollments       VentureEnrollment[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, applicationId])
  @@unique([organizationId, applicationId])
  @@unique([organizationId, fundingCallId, applicationId])
  @@unique([organizationId, agreementNumber])
  @@index([organizationId, status])
  @@index([organizationId, fundingCallId, status])
}

