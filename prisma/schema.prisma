generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum FundingProgramStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum FundingCallStatus {
  DRAFT
  OPEN
  IN_REVIEW
  CLOSED
  RESULT_PUBLISHED
  ARCHIVED
}

enum FundingCallDocumentType {
  NOTICE
  ANNEX
  AMENDMENT
  RESULT
  OTHER
}

enum IndicatorValueType {
  INTEGER
  CURRENCY
  ENUM
}

enum MetricAggregationMode {
  TOTAL
  MEAN
  MEDIAN
  DISTRIBUTION
}

enum AnalyticsReportType {
  PORTFOLIO_EXECUTIVE
  PROGRAM_SUMMARY
  COHORT_LONGITUDINAL
  DATA_QUALITY
  EXECUTION_SUMMARY
}

enum DataExportType {
  COHORT_OBSERVATIONS
  COHORT_AGGREGATES
  PROGRAM_SUMMARY
  EXECUTION_SUMMARY
  APPLICATIONS_SUMMARY
  PORTFOLIO_SUMMARY
}

enum MilestoneType {
  MVP_LAUNCHED
  FIRST_CUSTOMER
  COMPANY_FORMALIZED
  RECURRING_CONTRACT
  ADDITIONAL_INVESTMENT
  TEAM_EXPANSION
  PIVOT
  CLOSED
}

enum OpportunityStatus {
  OPEN
  UPCOMING
  IN_REVIEW
  CLOSED
  RESULT_PUBLISHED
  ARCHIVED
}

enum CohortStatus {
  PLANNED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum VentureKind {
  COMPANY
  PROJECT
  INITIATIVE
  OTHER
}

enum VentureEnrollmentStatus {
  ACTIVE
  WITHDRAWN
}

enum FollowUpWaveKind {
  BASELINE
  FOLLOW_UP
}

enum FollowUpWaveStatus {
  PLANNED
  OPEN
  CLOSED
  ARCHIVED
}

enum VentureObservationStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  MISSED
}

enum TeamRole {
  OWNER
  LEAD
  MEMBER
}

enum ProjectRole {
  OWNER
  LEAD
  MEMBER
}

enum ProjectStatus {
  IDEA
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  DECIDED
  WITHDRAWN
}

enum ApplicationDecision {
  PENDING
  SELECTED
  WAITLIST
  NOT_SELECTED
  DISQUALIFIED
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
}

enum VisibilityScope {
  PUBLIC
  PLATFORM
  TEAM
  PRIVATE
}

enum ProfileTopicType {
  SKILL
  INTEREST
}

enum ProfileLinkType {
  WEBSITE
  LINKEDIN
  GITHUB
  ORCID
  PORTFOLIO
  OTHER
}

enum OpportunitySupportType {
  SUBVENTION
  SCHOLARSHIP
  CREDIT
  RESIDENCY
  ACCELERATION
  PRIZE
  SERVICES
  OTHER
}

enum OpportunityTerritoryScope {
  MUNICIPAL
  STATE
  REGIONAL
  NATIONAL
  INTERNATIONAL
  UNSPECIFIED
}

model User {
  id                           String                          @id @default(cuid())
  email                        String                          @unique
  passwordHash                 String
  platformRole                 PlatformRole                    @default(USER)
  sessionVersion               Int                             @default(0)
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt
  profile                      UserProfile?
  memberships                  OrganizationMembership[]
  invitationsSent              OrganizationInvite[]            @relation("InvitedBy")
  sessions                     Session[]
  passwordResetTokens          PasswordResetToken[]
  fundingProgramsCreated       FundingProgram[]                @relation("FundingProgramCreatedBy")
  teamsCreated                 Team[]                          @relation("TeamCreatedBy")
  teamMemberships              TeamMembership[]
  teamInvitesSent              TeamInvite[]                    @relation("TeamInvitedBy")
  teamInvitesAccepted          TeamInvite[]                    @relation("TeamInviteAcceptedBy")
  projectsCreated              Project[]                       @relation("ProjectCreatedBy")
  projectMemberships           ProjectMembership[]
  applicationsSubmitted        Application[]                   @relation("ApplicationSubmittedBy")
  applicationDecisions         Application[]                   @relation("ApplicationDecidedBy")
  applicationEvaluations       ApplicationEvaluation[]
  innovationProfile            InnovationProfile?
  savedFundingCalls            SavedFundingCall[]
  savedExternalOpportunities   SavedExternalOpportunity[]
  awardsCreated                Award[]                         @relation("AwardCreatedBy")
  awardStatusChanges           AwardStatusHistory[]
  awardObligationsCreated      AwardObligation[]               @relation("AwardObligationCreatedBy")
  awardObligationsWaived       AwardObligation[]               @relation("AwardObligationWaivedBy")
  awardDueDateChanges          AwardObligationDueDateHistory[]
  awardSubmissionsAuthored     AwardSubmission[]               @relation("AwardSubmissionCreatedBy")
  awardSubmissionsSent         AwardSubmission[]               @relation("AwardSubmissionSubmittedBy")
  awardSubmissionsReviewed     AwardSubmission[]               @relation("AwardSubmissionReviewedBy")
  awardDisbursementsCreated    AwardDisbursement[]             @relation("AwardDisbursementCreatedBy")
  awardDisbursementsRecorded   AwardDisbursement[]             @relation("AwardDisbursementPaidBy")
  awardDocumentsCreated        AwardDocument[]
  projectTasksCreated          ProjectTask[]                   @relation("ProjectTaskCreatedBy")
  projectTasksAssigned         ProjectTask[]                   @relation("ProjectTaskAssignee")
  projectResourcesCreated      ProjectResource[]
  analyticsReportsGenerated    AnalyticsReportSnapshot[]       @relation("AnalyticsReportGeneratedBy")
  dataExports                  DataExportAudit[]
  resultPublicationsCreated    PublicResultPublication[]       @relation("ResultPublicationCreatedBy")
  resultPublicationsApproved   PublicResultPublication[]       @relation("ResultPublicationPublishedBy")
  targetedTeamInvites          TeamInvite[]                    @relation("TeamInviteTarget")
  connectionRequestsSent       ConnectionRequest[]             @relation("ConnectionRequester")
  connectionRequestsReceived   ConnectionRequest[]             @relation("ConnectionRecipient")
  connectionsA                 NetworkConnection[]             @relation("ConnectionUserA")
  connectionsB                 NetworkConnection[]             @relation("ConnectionUserB")
  connectionsEnded             NetworkConnection[]             @relation("ConnectionEndedBy")
  projectCollaborationRequests ProjectCollaborationRequest[]   @relation("ProjectRequestRequester")
  projectRequestsReviewed      ProjectCollaborationRequest[]   @relation("ProjectRequestReviewer")
  projectInvitesReceived       ProjectInvite[]                 @relation("ProjectInviteTarget")
  projectInvitesSent           ProjectInvite[]                 @relation("ProjectInviter")
  blocksInitiated              UserBlock[]                     @relation("BlockInitiator")
  blocksReceived               UserBlock[]                     @relation("BlockTarget")
  notificationsReceived        Notification[]                  @relation("NotificationRecipient")
  notificationsActed           Notification[]                  @relation("NotificationActor")
  conversationsA               Conversation[]                  @relation("ConversationUserA")
  conversationsB               Conversation[]                  @relation("ConversationUserB")
  conversationParticipations   ConversationParticipant[]
  directMessages               DirectMessage[]
  discussionsCreated           ProjectDiscussion[]
  discussionMessages           ProjectDiscussionMessage[]
  discussionSubscriptions      ProjectDiscussionSubscription[]
  safetyReportsFiled           SafetyReport[]                  @relation("SafetyReporter")
  safetyReportsReceived        SafetyReport[]                  @relation("SafetyReported")
  safetyReportsReviewed        SafetyReport[]                  @relation("SafetyReviewer")
  importBatches                ImportBatch[]                   @relation("ImportCreatedBy")
  importsApplied               ImportBatch[]                   @relation("ImportAppliedBy")
  importsRolledBack            ImportBatch[]                   @relation("ImportRolledBackBy")
  followings                   UserFollow[]                    @relation("FollowFollower")
  followers                    UserFollow[]                    @relation("FollowFollowed")
  socialPosts                  SocialPost[]
  postReactions                PostReaction[]
  postComments                 PostComment[]
  commentReactions             CommentReaction[]
  savedPosts                   SavedPost[]
  featuredPosts                FeaturedPost[]
  socialRateLimitEvents        SocialRateLimitEvent[]
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  jobTitle  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InnovationProfile {
  id                              String               @id @default(cuid())
  userId                          String               @unique
  handle                          String?              @unique @db.VarChar(64)
  headline                        String?
  bio                             String?
  city                            String?
  state                           String?
  country                         String?
  profileVisibility               VisibilityScope      @default(PRIVATE)
  skillsVisibility                VisibilityScope      @default(PRIVATE)
  experienceVisibility            VisibilityScope      @default(PRIVATE)
  educationVisibility             VisibilityScope      @default(PRIVATE)
  linksVisibility                 VisibilityScope      @default(PRIVATE)
  verifiedParticipationVisibility VisibilityScope      @default(PRIVATE)
  projectsVisibility              VisibilityScope      @default(PRIVATE)
  publishedAt                     DateTime?
  directoryEnabled                Boolean              @default(false)
  collaborationStatus             CollaborationStatus  @default(NOT_AVAILABLE)
  collaborationNote               String?
  followPolicy                    FollowPolicy         @default(EVERYONE)
  primaryProfileAction            PrimaryProfileAction @default(CONNECT)
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt
  user                            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics                          ProfileTopic[]
  education                       ProfileEducation[]
  experience                      ProfileExperience[]
  links                           ProfileLink[]

  @@index([directoryEnabled, profileVisibility, collaborationStatus, userId])
}

model ProfileTopic {
  id            String            @id @default(cuid())
  profileId     String
  type          ProfileTopicType
  label         String
  normalizedKey String
  position      Int               @default(0)
  profile       InnovationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type, normalizedKey])
  @@index([profileId, type, position])
}

model ProfileEducation {
  id          String            @id @default(cuid())
  profileId   String
  institution String
  course      String
  degree      String?
  startsAt    DateTime?         @db.Date
  endsAt      DateTime?         @db.Date
  description String?
  visibility  VisibilityScope   @default(PRIVATE)
  position    Int               @default(0)
  profile     InnovationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

model ProfileExperience {
  id               String            @id @default(cuid())
  profileId        String
  organizationName String
  title            String
  startsAt         DateTime          @db.Date
  endsAt           DateTime?         @db.Date
  current          Boolean           @default(false)
  description      String?
  visibility       VisibilityScope   @default(PRIVATE)
  position         Int               @default(0)
  profile          InnovationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

model ProfileLink {
  id         String            @id @default(cuid())
  profileId  String
  label      String
  url        String
  type       ProfileLinkType   @default(OTHER)
  visibility VisibilityScope   @default(PRIVATE)
  position   Int               @default(0)
  profile    InnovationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

model Organization {
  id                   String                         @id @default(cuid())
  name                 String
  slug                 String                         @unique
  status               OrganizationStatus             @default(ACTIVE)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  memberships          OrganizationMembership[]
  invites              OrganizationInvite[]
  activeSessions       Session[]                      @relation("SessionActiveOrganization")
  fundingPrograms      FundingProgram[]
  fundingCalls         FundingCall[]
  fundingCallDocuments FundingCallDocument[]
  cohorts              Cohort[]
  ventures             Venture[]
  enrollments          VentureEnrollment[]
  followUpWaves        FollowUpWave[]
  observations         VentureObservation[]
  trackingProtocols    TrackingProtocol[]
  protocolVersions     TrackingProtocolVersion[]
  indicatorDefinitions IndicatorDefinition[]
  observationValues    ObservationValue[]
  milestones           Milestone[]
  opportunities        Opportunity[]
  applications         Application[]
  evaluationCriteria   EvaluationCriterion[]
  evaluations          ApplicationEvaluation[]
  awards               Award[]
  metricDefinitions    MetricDefinition[]
  analyticsReports     AnalyticsReportSnapshot[]
  dataExports          DataExportAudit[]
  analyticsSettings    OrganizationAnalyticsSettings?
  resultPublications   PublicResultPublication[]
  importBatches        ImportBatch[]
  externalReferences   ExternalReference[]
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model OrganizationInvite {
  id              String           @id @default(cuid())
  organizationId  String
  invitedByUserId String
  email           String
  role            OrganizationRole
  status          InvitationStatus @default(PENDING)
  tokenHash       String           @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([email, status])
}

model Session {
  id                   String        @id @default(cuid())
  userId               String
  tokenHash            String        @unique
  sessionVersion       Int
  activeOrganizationId String?
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime      @default(now())
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation("SessionActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model FundingProgram {
  id               String                    @id @default(cuid())
  organizationId   String
  name             String
  slug             String
  description      String?
  code             String?
  status           FundingProgramStatus      @default(DRAFT)
  createdByUserId  String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User                      @relation("FundingProgramCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cohorts          Cohort[]
  fundingCalls     FundingCall[]
  analyticsReports AnalyticsReportSnapshot[]
  dataExports      DataExportAudit[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model FundingCall {
  id                   String                    @id @default(cuid())
  organizationId       String
  fundingProgramId     String
  title                String
  shortTitle           String?
  callNumber           String
  objective            String?
  status               FundingCallStatus         @default(DRAFT)
  publishedAt          DateTime?
  applicationStartsAt  DateTime?
  applicationEndsAt    DateTime?
  totalBudget          Decimal?                  @db.Decimal(14, 2)
  maximumSupport       Decimal?                  @db.Decimal(14, 2)
  targetProjects       Int?
  executionMonths      Int?
  sourceUrl            String?
  sourceCheckedAt      DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingProgram       FundingProgram            @relation(fields: [organizationId, fundingProgramId], references: [organizationId, id], onDelete: Cascade)
  cohorts              Cohort[]
  documents            FundingCallDocument[]
  applicationsEnabled  Boolean                   @default(false)
  evaluationStartedAt  DateTime?
  resultsPublishedAt   DateTime?
  applications         Application[]
  evaluationCriteria   EvaluationCriterion[]
  evaluations          ApplicationEvaluation[]
  publicListingEnabled Boolean                   @default(false)
  supportType          OpportunitySupportType    @default(OTHER)
  territoryScope       OpportunityTerritoryScope @default(UNSPECIFIED)
  territoryLabel       String?
  eligibleStates       String[]                  @default([])
  audienceTags         String[]                  @default([])
  thematicAreas        String[]                  @default([])
  savedBy              SavedFundingCall[]
  awards               Award[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, fundingProgramId])
  @@unique([organizationId, callNumber])
  @@index([organizationId, status])
  @@index([publicListingEnabled, status, applicationEndsAt])
}

model FundingCallDocument {
  id                   String                  @id @default(cuid())
  organizationId       String
  fundingCallId        String
  type                 FundingCallDocumentType
  title                String
  externalUrl          String
  publishedAt          DateTime?
  publicListingEnabled Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingCall          FundingCall             @relation(fields: [organizationId, fundingCallId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, fundingCallId, title])
  @@index([organizationId, fundingCallId])
}

model Cohort {
  id                        String                    @id @default(cuid())
  organizationId            String
  fundingProgramId          String
  fundingCallId             String?
  trackingProtocolVersionId String?
  name                      String
  code                      String?
  referenceYear             Int?
  startsAt                  DateTime?
  endsAt                    DateTime?
  status                    CohortStatus              @default(PLANNED)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingProgram            FundingProgram            @relation(fields: [organizationId, fundingProgramId], references: [organizationId, id], onDelete: Cascade)
  fundingCall               FundingCall?              @relation(fields: [organizationId, fundingCallId, fundingProgramId], references: [organizationId, id, fundingProgramId], onDelete: Restrict)
  trackingProtocolVersion   TrackingProtocolVersion?  @relation(fields: [organizationId, trackingProtocolVersionId], references: [organizationId, id], onDelete: Restrict)
  enrollments               VentureEnrollment[]
  followUpWaves             FollowUpWave[]
  observations              VentureObservation[]
  analyticsReports          AnalyticsReportSnapshot[]
  dataExports               DataExportAudit[]

  @@unique([organizationId, id])
  @@unique([organizationId, fundingProgramId, code])
  @@index([organizationId, fundingCallId])
  @@index([organizationId, trackingProtocolVersionId])
  @@index([organizationId, fundingProgramId, status])
}

model Venture {
  id                String              @id @default(cuid())
  organizationId    String
  name              String
  slug              String?
  legalName         String?
  kind              VentureKind
  externalReference String?
  archivedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sourceProjectId   String?
  sourceProject     Project?            @relation(fields: [sourceProjectId], references: [id], onDelete: Restrict)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments       VentureEnrollment[]
  milestones        Milestone[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@unique([organizationId, sourceProjectId])
  @@index([organizationId, kind, archivedAt])
}

model VentureEnrollment {
  id                String                  @id @default(cuid())
  organizationId    String
  cohortId          String
  ventureId         String
  externalReference String?
  enrolledAt        DateTime                @default(now())
  withdrawnAt       DateTime?
  status            VentureEnrollmentStatus @default(ACTIVE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  applicationId     String?
  awardId           String?
  award             Award?                  @relation(fields: [organizationId, awardId, applicationId], references: [organizationId, id, applicationId], onDelete: Restrict)
  application       Application?            @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Restrict)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cohort            Cohort                  @relation(fields: [organizationId, cohortId], references: [organizationId, id], onDelete: Cascade)
  venture           Venture                 @relation(fields: [organizationId, ventureId], references: [organizationId, id], onDelete: Cascade)
  observations      VentureObservation[]

  @@unique([organizationId, cohortId, ventureId])
  @@unique([organizationId, applicationId])
  @@unique([organizationId, awardId])
  @@unique([organizationId, cohortId, id])
  @@index([organizationId, cohortId, status])
  @@index([organizationId, cohortId, withdrawnAt])
  @@index([organizationId, ventureId, status])
}

model FollowUpWave {
  id             String               @id @default(cuid())
  organizationId String
  cohortId       String
  name           String
  kind           FollowUpWaveKind     @default(FOLLOW_UP)
  sequence       Int
  offsetMonths   Int?
  scheduledFor   DateTime?
  opensAt        DateTime?
  closesAt       DateTime?
  status         FollowUpWaveStatus   @default(PLANNED)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cohort         Cohort               @relation(fields: [organizationId, cohortId], references: [organizationId, id], onDelete: Cascade)
  observations   VentureObservation[]

  @@unique([organizationId, cohortId, id])
  @@unique([organizationId, cohortId, sequence])
  @@index([organizationId, cohortId, status])
}

model VentureObservation {
  id                  String                   @id @default(cuid())
  organizationId      String
  cohortId            String
  ventureEnrollmentId String
  followUpWaveId      String
  status              VentureObservationStatus @default(PENDING)
  revision            Int                      @default(0)
  startedAt           DateTime?
  submittedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cohort              Cohort                   @relation(fields: [organizationId, cohortId], references: [organizationId, id], onDelete: Cascade)
  ventureEnrollment   VentureEnrollment        @relation(fields: [organizationId, cohortId, ventureEnrollmentId], references: [organizationId, cohortId, id], onDelete: Cascade)
  followUpWave        FollowUpWave             @relation(fields: [organizationId, cohortId, followUpWaveId], references: [organizationId, cohortId, id], onDelete: Cascade)
  values              ObservationValue[]

  @@unique([organizationId, id])
  @@unique([organizationId, ventureEnrollmentId, followUpWaveId])
  @@index([organizationId, cohortId, status])
  @@index([organizationId, ventureEnrollmentId, status])
  @@index([organizationId, followUpWaveId, status])
}

model TrackingProtocol {
  id             String                    @id @default(cuid())
  organizationId String
  slug           String
  name           String
  description    String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       TrackingProtocolVersion[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
}

model TrackingProtocolVersion {
  id                 String                @id @default(cuid())
  organizationId     String
  trackingProtocolId String
  version            Int
  label              String?
  createdAt          DateTime              @default(now())
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackingProtocol   TrackingProtocol      @relation(fields: [organizationId, trackingProtocolId], references: [organizationId, id], onDelete: Cascade)
  cohorts            Cohort[]
  indicators         IndicatorDefinition[]

  @@unique([organizationId, id])
  @@unique([organizationId, trackingProtocolId, version])
}

model IndicatorDefinition {
  id                        String                  @id @default(cuid())
  organizationId            String
  trackingProtocolVersionId String
  key                       String
  label                     String
  valueType                 IndicatorValueType
  unit                      String?
  position                  Int                     @default(0)
  allowedValues             Json?
  metricDefinitionId        String?
  metricDefinition          MetricDefinition?       @relation(fields: [organizationId, metricDefinitionId], references: [organizationId, id], onDelete: Restrict)
  organization              Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackingProtocolVersion   TrackingProtocolVersion @relation(fields: [organizationId, trackingProtocolVersionId], references: [organizationId, id], onDelete: Cascade)
  observationValues         ObservationValue[]

  @@unique([organizationId, id])
  @@unique([organizationId, trackingProtocolVersionId, key])
  @@unique([organizationId, trackingProtocolVersionId, metricDefinitionId], map: "IndicatorDefinition_org_version_metric_key")
  @@index([organizationId, trackingProtocolVersionId, position])
  @@index([organizationId, metricDefinitionId])
}

model MetricDefinition {
  id                 String                @id @default(cuid())
  organizationId     String
  key                String                @db.VarChar(160)
  label              String
  description        String?
  valueType          IndicatorValueType
  unit               String?
  allowedValues      Json?
  primaryAggregation MetricAggregationMode
  archivedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  indicators         IndicatorDefinition[]

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@index([organizationId, archivedAt, label])
}

model AnalyticsReportSnapshot {
  id                     String                    @id @default(cuid())
  organizationId         String
