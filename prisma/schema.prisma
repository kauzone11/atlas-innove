generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum FundingProgramStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum CohortStatus {
  PLANNED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum VentureKind {
  COMPANY
  PROJECT
  INITIATIVE
  OTHER
}

enum VentureEnrollmentStatus {
  ACTIVE
  WITHDRAWN
}

model User {
  id                     String                   @id @default(cuid())
  email                  String                   @unique
  passwordHash           String
  platformRole           PlatformRole             @default(USER)
  sessionVersion         Int                      @default(0)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  profile                UserProfile?
  memberships            OrganizationMembership[]
  invitationsSent        OrganizationInvite[]     @relation("InvitedBy")
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  fundingProgramsCreated FundingProgram[]         @relation("FundingProgramCreatedBy")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  jobTitle  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id              String                   @id @default(cuid())
  name            String
  slug            String                   @unique
  status          OrganizationStatus       @default(ACTIVE)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  memberships     OrganizationMembership[]
  invites         OrganizationInvite[]
  activeSessions  Session[]                @relation("SessionActiveOrganization")
  fundingPrograms FundingProgram[]
  cohorts         Cohort[]
  ventures        Venture[]
  enrollments     VentureEnrollment[]
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model OrganizationInvite {
  id              String           @id @default(cuid())
  organizationId  String
  invitedByUserId String
  email           String
  role            OrganizationRole
  status          InvitationStatus @default(PENDING)
  tokenHash       String           @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([email, status])
}

model Session {
  id                   String        @id @default(cuid())
  userId               String
  tokenHash            String        @unique
  sessionVersion       Int
  activeOrganizationId String?
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime      @default(now())
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation("SessionActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model FundingProgram {
  id              String               @id @default(cuid())
  organizationId  String
  name            String
  slug            String
  description     String?
  code            String?
  status          FundingProgramStatus @default(DRAFT)
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("FundingProgramCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cohorts         Cohort[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model Cohort {
  id               String              @id @default(cuid())
  organizationId   String
  fundingProgramId String
  name             String
  code             String?
  referenceYear    Int?
  startsAt         DateTime?
  endsAt           DateTime?
  status           CohortStatus        @default(PLANNED)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingProgram   FundingProgram      @relation(fields: [organizationId, fundingProgramId], references: [organizationId, id], onDelete: Cascade)
  enrollments      VentureEnrollment[]

  @@unique([organizationId, id])
  @@index([organizationId, fundingProgramId, status])
}

model Venture {
  id                String              @id @default(cuid())
  organizationId    String
  name              String
  legalName         String?
  kind              VentureKind
  externalReference String?
  archivedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments       VentureEnrollment[]

  @@unique([organizationId, id])
  @@index([organizationId, kind, archivedAt])
}

model VentureEnrollment {
  id                String                  @id @default(cuid())
  organizationId    String
  cohortId          String
  ventureId         String
  externalReference String?
  enrolledAt        DateTime                @default(now())
  status            VentureEnrollmentStatus @default(ACTIVE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cohort            Cohort                  @relation(fields: [organizationId, cohortId], references: [organizationId, id], onDelete: Cascade)
  venture           Venture                 @relation(fields: [organizationId, ventureId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, cohortId, ventureId])
  @@index([organizationId, cohortId, status])
  @@index([organizationId, ventureId, status])
}
